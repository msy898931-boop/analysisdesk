# Copy to .env and fill in. All values are optional.
#
# GROQ_API_KEY — enables the AI explanation layer. Without it the app still
# runs: every analysis falls back to a computed sentence built from the same
# real numbers, and the card says so instead of pretending.
GROQ_API_KEY=

# PORT — the port uvicorn binds. Render and similar hosts set this themselves.
PORT=12000

# RATE_LIMIT_PER_MIN — per-IP requests/minute against the analysis endpoints.
RATE_LIMIT_PER_MIN=60

# DESK_TRUST_PROXY — set to 1 only when a proxy you control sits in front and
# appends the real client as the LAST X-Forwarded-For hop (Render does). Off,
# the header is caller-controlled and is ignored: the limit keys on the socket
# peer instead, so a script cannot mint a fresh identity per request.
DESK_TRUST_PROXY=

# DESK_API_KEY — if set, EVERY caller must present it, the bundled page included.
# A public page cannot hold a secret, so there is no page exemption; leave unset
# (as production does) to keep the page open, or set it for an API-only deploy.
DESK_API_KEY=

# ALERTS_TOKEN — the credential for the alerts API (/api/alerts*). That API is
# service-to-service: the bot arms and reads a user's alerts, and the user never
# calls it directly. A chat id selects the row; it is NOT the credential (it is
# an identifier that leaks through groups). Unset = the endpoints answer 503
# (closed), not open. Set it to the same value the bot sends as `x-alerts-token`.
ALERTS_TOKEN=

# DESK_DATA_DIR — where the SQLite store lives (alerts, visit counter). Point it
# at a mounted disk to make alerts survive a redeploy; otherwise the file sits on
# the container disk and is lost on restart (/api/status then reports
# store.durable:false).
DESK_DATA_DIR=

# ANALYSIS_MODELS — optional comma-separated fallback chain for the narrative.
ANALYSIS_MODELS=

# --- Alerts (off by default) ---
# ALERTS_ENABLED — delivery runs only when this is truthy AND a token is set.
ALERTS_ENABLED=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- The bot and the clock (both off by default) ---
# BOT_ENABLED — turns on the Telegram command receiver (getUpdates long poll).
# The bot arms/reads/removes alerts from the chat. Needs TELEGRAM_BOT_TOKEN AND
# an allowlist (below); with any of the three missing it stays shut.
BOT_ENABLED=
# TELEGRAM_ALLOWED_CHATS — comma-separated chat ids the bot will answer. Fails
# closed: empty (and no TELEGRAM_CHAT_ID) means it answers nobody. A token is a
# credential, not a permission, so this is its own decision.
TELEGRAM_ALLOWED_CHATS=
# SCHEDULER_ENABLED — turns on the in-process clock that calls alerts.run_once()
# every SCHEDULER_PERIOD_S. HONEST LIMIT: on a host that sleeps on idle (Render
# Free) this clock sleeps too -- it is best-effort, not a 24/7 schedule. For a
# real schedule, point a cron job at scripts/run_alerts.py instead.
SCHEDULER_ENABLED=
SCHEDULER_PERIOD_S=300
